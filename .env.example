# Copy this file to .env and fill in the keys you have.
# The runner reads .env from the project root. Do not commit .env.

# Used when a model entry has provider: openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Used when a model entry has provider: openrouter
# OpenRouter is OpenAI-compatible: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=FuturePrefs
